using ProjectMTGCollector.Models;
using ProjectMTGCollector.Services;

namespace ProjectMTGCollector.Forms;

public partial class MainForm : Form
{
    private readonly ScryfallService _scryfallService;
    private readonly ImageCacheService _imageCacheService;
    private List<Set> _allSets = new();
    private Set? _currentSelectedSet;
    private List<Card> _currentSetCards = new();
    private Card? _currentCard;
    private List<Card> _currentCardVariants = new();
    private bool _isAscendingSort = true;

    public MainForm()
    {
        InitializeComponent();
        _scryfallService = new ScryfallService();
        _imageCacheService = new ImageCacheService();
    }

    // Search Card Tab Events
    private async void BtnSearchCard_Click(object? sender, EventArgs e)
    {
        await SearchCard();
    }

    private async void TxtSearchCard_KeyDown(object? sender, KeyEventArgs e)
    {
        if (e.KeyCode == Keys.Enter)
        {
            e.SuppressKeyPress = true;
            await SearchCard();
        }
    }

    private async Task SearchCard()
    {
        var cardName = txtSearchCard.Text.Trim();
        if (string.IsNullOrWhiteSpace(cardName))
        {
            MessageBox.Show("Please enter a card name.", "Search Card", MessageBoxButtons.OK, MessageBoxIcon.Information);
            return;
        }

        btnSearchCard.Enabled = false;
        btnSearchCard.Text = "Searching...";
        
        try
        {
            var card = await _scryfallService.GetCardByNameAsync(cardName);
            
            if (card != null)
            {
                _currentCard = card;
                await DisplayCard(card);
                btnLoadVariants.Enabled = true;
            }
            else
            {
                MessageBox.Show("Card not found.", "Search Card", MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearCardDisplay();
            }
        }
        catch (Exception ex)
        {
            MessageBox.Show($"Error searching for card: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
        finally
        {
            btnSearchCard.Enabled = true;
            btnSearchCard.Text = "Search";
        }
    }

    private async void BtnLoadVariants_Click(object? sender, EventArgs e)
    {
        if (_currentCard == null)
            return;

        btnLoadVariants.Enabled = false;
        btnLoadVariants.Text = "Loading...";

        try
        {
            _currentCardVariants = await _scryfallService.GetAllPrintingsAsync(_currentCard.Name);
            DisplayVariants(_currentCardVariants);
        }
        catch (Exception ex)
        {
            MessageBox.Show($"Error loading variants: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
        finally
        {
            btnLoadVariants.Enabled = true;
            btnLoadVariants.Text = "Reload Variants";
        }
    }

    private void DisplayVariants(List<Card> variants)
    {
        listViewVariants.Items.Clear();

        if (variants.Count == 0)
        {
            lblVariantsHeader.Text = "Variants & Printings: None found";
            return;
        }

        lblVariantsHeader.Text = $"Variants & Printings: {variants.Count} found";

        foreach (var variant in variants)
        {
            var variantType = GetVariantDescription(variant);
            
            var item = new ListViewItem(variant.SetName);
            item.SubItems.Add(variantType);
            item.SubItems.Add(variant.CollectorNumber);
            
            // Nonfoil price
            var nonfoilPrice = !string.IsNullOrEmpty(variant.Prices?.Usd) 
                ? $"${variant.Prices.Usd}" 
                : (!string.IsNullOrEmpty(variant.Prices?.Eur) ? $"€{variant.Prices.Eur}" : "N/A");
            item.SubItems.Add(nonfoilPrice);
            
            // Foil price
            var foilPrice = !string.IsNullOrEmpty(variant.Prices?.UsdFoil) 
                ? $"${variant.Prices.UsdFoil}" 
                : (!string.IsNullOrEmpty(variant.Prices?.EurFoil) ? $"€{variant.Prices.EurFoil}" : "N/A");
            item.SubItems.Add(foilPrice);
            
            item.SubItems.Add(variant.ReleasedAt ?? "N/A");
            item.Tag = variant;
            
            listViewVariants.Items.Add(item);
        }
    }

    private string GetVariantDescription(Card card)
    {
        var descriptions = new List<string>();

        if (card.Promo)
            descriptions.Add("Promo");

        if (card.FrameEffects != null && card.FrameEffects.Any())
        {
            foreach (var effect in card.FrameEffects)
            {
                descriptions.Add(effect switch
                {
                    "showcase" => "Showcase",
                    "extendedart" => "Extended Art",
                    "borderless" => "Borderless",
                    "inverted" => "Inverted",
                    "etched" => "Etched",
                    _ => effect
                });
            }
        }

        if (card.Finishes != null)
        {
            if (card.Finishes.Contains("foil") && !card.Finishes.Contains("nonfoil"))
                descriptions.Add("Foil Only");
            else if (card.Finishes.Contains("etched"))
                descriptions.Add("Etched Available");
        }

        if (card.BorderColor != null && card.BorderColor != "black")
            descriptions.Add($"{card.BorderColor} border");

        return descriptions.Any() ? string.Join(", ", descriptions) : "Standard";
    }

    private async void ListViewVariants_SelectedIndexChanged(object? sender, EventArgs e)
    {
        if (listViewVariants.SelectedItems.Count > 0)
        {
            var variant = (Card)listViewVariants.SelectedItems[0].Tag;
            await DisplayCard(variant);
        }
    }

    private async Task DisplayCard(Card card)
    {
        lblCardName.Text = card.Name;
        
        // Display current value prominently
        lblCardValue.Text = FormatCardValue(card.Prices);
        
        lblManaCost.Text = $"Mana Cost: {card.ManaCost ?? "N/A"} (CMC: {card.ConvertedManaCost})";
        lblType.Text = $"Type: {card.TypeLine}";
        lblOracleText.Text = $"Text:\n{card.OracleText ?? "N/A"}";
        
        if (!string.IsNullOrEmpty(card.Power) && !string.IsNullOrEmpty(card.Toughness))
            lblPowerToughness.Text = $"Power/Toughness: {card.Power}/{card.Toughness}";
        else
            lblPowerToughness.Text = "";
        
        lblSetInfo.Text = $"Set: {card.SetName} ({card.Set.ToUpper()}) #{card.CollectorNumber}";
        lblRarity.Text = $"Rarity: {card.Rarity}";
        lblArtist.Text = $"Artist: {card.Artist ?? "Unknown"}";
        
        // Enhanced prices display with variant info
        if (card.Prices != null)
        {
            var priceText = "This Version:\n";
            if (!string.IsNullOrEmpty(card.Prices.Usd))
                priceText += $"  USD (Nonfoil): ${card.Prices.Usd}\n";
            if (!string.IsNullOrEmpty(card.Prices.UsdFoil))
                priceText += $"  USD (Foil): ${card.Prices.UsdFoil}\n";
            if (!string.IsNullOrEmpty(card.Prices.Eur))
                priceText += $"  EUR (Nonfoil): €{card.Prices.Eur}\n";
            if (!string.IsNullOrEmpty(card.Prices.EurFoil))
                priceText += $"  EUR (Foil): €{card.Prices.EurFoil}\n";
            if (!string.IsNullOrEmpty(card.Prices.Tix))
                priceText += $"  MTGO Tix: {card.Prices.Tix}\n";
            
            // Add variant info
            var variantInfo = GetVariantDescription(card);
            if (variantInfo != "Standard")
                priceText += $"\nVariant Type: {variantInfo}";
            
            lblPrices.Text = priceText;
        }
        else
        {
            lblPrices.Text = "Prices: Not available";
        }
        
        if (card.Legalities != null && card.Legalities.Any())
        {
            var legalText = "Format Legalities:\n";
            foreach (var legality in card.Legalities.Where(l => l.Value == "legal"))
            {
                legalText += $"  {legality.Key}: {legality.Value}\n";
            }
            lblLegalities.Text = legalText;
        }
        else
        {
            lblLegalities.Text = "";
        }
        
        // Load image
        string? imageUrl = card.ImageUris?.Normal ?? card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
        if (!string.IsNullOrEmpty(imageUrl))
        {
            var image = await _imageCacheService.GetImageAsync(imageUrl);
            if (image != null)
            {
                picCardImage.Image = image;
            }
        }
        else
        {
            picCardImage.Image = null;
        }
    }

    private string FormatCardValue(Prices? prices)
    {
        if (prices == null)
            return "Current Value: Not Available";
        
        var pricesList = new List<string>();
        
        if (!string.IsNullOrEmpty(prices.Usd))
            pricesList.Add($"${prices.Usd} USD");
        
        if (!string.IsNullOrEmpty(prices.UsdFoil))
            pricesList.Add($"${prices.UsdFoil} USD Foil");
        
        if (!string.IsNullOrEmpty(prices.Eur))
            pricesList.Add($"€{prices.Eur} EUR");
        
        if (pricesList.Count == 0)
            return "Current Value: Not Available";
        
        return $"💰 Current Value: {string.Join(" | ", pricesList)}";
    }

    private void ClearCardDisplay()
    {
        _currentCard = null;
        _currentCardVariants.Clear();
        lblCardName.Text = "";
        lblCardValue.Text = "";
        lblManaCost.Text = "";
        lblType.Text = "";
        lblOracleText.Text = "";
        lblPowerToughness.Text = "";
        lblSetInfo.Text = "";
        lblRarity.Text = "";
        lblArtist.Text = "";
        lblPrices.Text = "";
        lblVariantsHeader.Text = "Variants & Printings:";
        listViewVariants.Items.Clear();
        lblLegalities.Text = "";
        picCardImage.Image = null;
        btnLoadVariants.Enabled = false;
    }

    // Browse Sets Tab Events
    private async void BtnSearchSet_Click(object? sender, EventArgs e)
    {
        await LoadAllSets();
    }

    private void TxtSearchSet_TextChanged(object? sender, EventArgs e)
    {
        FilterSets();
    }

    private async Task LoadAllSets()
    {
        btnSearchSet.Enabled = false;
        btnSearchSet.Text = "Loading...";
        
        try
        {
            _allSets = await _scryfallService.GetAllSetsAsync();
            _allSets = _allSets.OrderByDescending(s => s.ReleasedAt).ToList();
            
            DisplaySets(_allSets);
        }
        catch (Exception ex)
        {
            MessageBox.Show($"Error loading sets: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
        finally
        {
            btnSearchSet.Enabled = true;
            btnSearchSet.Text = "Reload Sets";
        }
    }

    private void DisplaySets(List<Set> sets)
    {
        listViewSets.Items.Clear();
        
        foreach (var set in sets)
        {
            var item = new ListViewItem(set.Name);
            item.SubItems.Add(set.Code.ToUpper());
            item.SubItems.Add(set.CardCount.ToString());
            item.SubItems.Add(set.ReleasedAt ?? "N/A");
            item.SubItems.Add(set.SetType);
            item.Tag = set;
            listViewSets.Items.Add(item);
        }
    }

    private void FilterSets()
    {
        if (_allSets.Count == 0)
            return;
        
        var filter = txtSearchSet.Text.Trim().ToLower();
        if (string.IsNullOrWhiteSpace(filter))
        {
            DisplaySets(_allSets);
        }
        else
        {
            var filtered = _allSets.Where(s => 
                s.Name.ToLower().Contains(filter) || 
                s.Code.ToLower().Contains(filter)).ToList();
            DisplaySets(filtered);
        }
    }

    private void ListViewSets_SelectedIndexChanged(object? sender, EventArgs e)
    {
        if (listViewSets.SelectedItems.Count > 0)
        {
            var set = (Set)listViewSets.SelectedItems[0].Tag;
            DisplaySetDetails(set);
        }
    }

    private void DisplaySetDetails(Set set)
    {
        _currentSelectedSet = set;
        lblSetName.Text = set.Name;
        lblSetCode.Text = $"Code: {set.Code.ToUpper()}";
        lblSetType.Text = $"Type: {set.SetType}";
        lblCardCount.Text = $"Cards: {set.CardCount}";
        lblReleaseDate.Text = $"Released: {set.ReleasedAt ?? "Unknown"}";
