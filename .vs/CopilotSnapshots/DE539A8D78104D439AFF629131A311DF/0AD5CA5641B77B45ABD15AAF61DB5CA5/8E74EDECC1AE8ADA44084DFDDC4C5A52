    }

    private async void BtnViewSetCards_Click(object? sender, EventArgs e)
    {
        if (_currentSelectedSet == null)
            return;
        
        await LoadSetCards(_currentSelectedSet);
        tabControl.SelectedTab = tabSetCards;
    }

    // Set Cards Tab Events
    private async Task LoadSetCards(Set set)
    {
        lblCurrentSet.Text = $"Loading cards from {set.Name}...";
        flowLayoutPanelCards.Controls.Clear();
        btnViewSetCards.Enabled = false;
        
        try
        {
            _currentSetCards = await _scryfallService.GetCardsBySetAsync(set.Code);
            lblCurrentSet.Text = $"{set.Name} ({set.Code.ToUpper()}) - {_currentSetCards.Count} cards";
            
            // Reset sort to default
            _isAscendingSort = true;
            btnToggleSortOrder.Text = "↑ Ascending";
            
            ApplySortAndDisplay();
        }
        catch (Exception ex)
        {
            MessageBox.Show($"Error loading cards: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            lblCurrentSet.Text = $"Error loading {set.Name}";
        }
        finally
        {
            btnViewSetCards.Enabled = true;
        }
    }

    private void CmbSortBy_SelectedIndexChanged(object? sender, EventArgs e)
    {
        if (_currentSetCards.Count > 0)
        {
            ApplySortAndDisplay();
        }
    }

    private void BtnToggleSortOrder_Click(object? sender, EventArgs e)
    {
        _isAscendingSort = !_isAscendingSort;
        btnToggleSortOrder.Text = _isAscendingSort ? "↑ Ascending" : "↓ Descending";
        
        if (_currentSetCards.Count > 0)
        {
            ApplySortAndDisplay();
        }
    }

    private void ApplySortAndDisplay()
    {
        var sortedCards = SortCards(_currentSetCards);
        UpdateSortOrderLabel();
        _ = DisplaySetCards(sortedCards);
    }

    private List<Card> SortCards(List<Card> cards)
    {
        var sortBy = cmbSortBy.SelectedIndex;
        
        IOrderedEnumerable<Card> sorted = sortBy switch
        {
            0 => _isAscendingSort 
                ? cards.OrderBy(c => GetNumericCollectorNumber(c.CollectorNumber))
                : cards.OrderByDescending(c => GetNumericCollectorNumber(c.CollectorNumber)),
            1 => _isAscendingSort 
                ? cards.OrderBy(c => GetCardPrice(c.Prices))
                : cards.OrderByDescending(c => GetCardPrice(c.Prices)),
            2 => _isAscendingSort 
                ? cards.OrderBy(c => GetRarityOrder(c.Rarity))
                : cards.OrderByDescending(c => GetRarityOrder(c.Rarity)),
            3 => _isAscendingSort 
                ? cards.OrderBy(c => c.Name)
                : cards.OrderByDescending(c => c.Name),
            _ => cards.OrderBy(c => GetNumericCollectorNumber(c.CollectorNumber))
        };
        
        return sorted.ToList();
    }

    private int GetNumericCollectorNumber(string collectorNumber)
    {
        // Extract numeric part from collector number (e.g., "123a" -> 123)
        var numericPart = new string(collectorNumber.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(numericPart, out int result) ? result : int.MaxValue;
    }

    private decimal GetCardPrice(Prices? prices)
    {
        if (prices == null)
            return 0;
        
        if (!string.IsNullOrEmpty(prices.Usd) && decimal.TryParse(prices.Usd, out decimal usdPrice))
            return usdPrice;
        
        if (!string.IsNullOrEmpty(prices.Eur) && decimal.TryParse(prices.Eur, out decimal eurPrice))
            return eurPrice * 1.1m; // Approximate conversion
        
        return 0;
    }

    private int GetRarityOrder(string rarity)
    {
        return rarity.ToLower() switch
        {
            "common" => 1,
            "uncommon" => 2,
            "rare" => 3,
            "mythic" => 4,
            "special" => 5,
            "bonus" => 6,
            _ => 0
        };
    }

    private void UpdateSortOrderLabel()
    {
        var sortBy = cmbSortBy.SelectedIndex;
        var direction = _isAscendingSort ? "lowest to highest" : "highest to lowest";
        
        var sortDescription = sortBy switch
        {
            0 => $"Sorted by card number ({direction})",
            1 => $"Sorted by value ({direction})",
            2 => _isAscendingSort ? "Sorted by rarity (common to mythic)" : "Sorted by rarity (mythic to common)",
            3 => $"Sorted alphabetically ({(_isAscendingSort ? "A-Z" : "Z-A")})",
            _ => ""
        };
        
        lblSortOrder.Text = sortDescription;
    }

    private async Task DisplaySetCards(List<Card> cards)
    {
        flowLayoutPanelCards.SuspendLayout();
        flowLayoutPanelCards.Controls.Clear();
        
        foreach (var card in cards)
        {
            var cardPanel = new Panel
            {
                Width = 180,
                Height = 300,
                Margin = new Padding(5),
                BorderStyle = BorderStyle.FixedSingle,
                Cursor = Cursors.Hand,
                Tag = card
            };
            
            var picBox = new PictureBox
            {
                Width = 170,
                Height = 237,
                Location = new Point(5, 5),
                SizeMode = PictureBoxSizeMode.Zoom,
                Tag = card
            };
            
            var lblName = new Label
            {
                Width = 170,
                Height = 25,
                Location = new Point(5, 245),
                Text = card.Name,
                TextAlign = ContentAlignment.MiddleCenter,
                Font = new Font("Segoe UI", 7F),
                Tag = card
            };
            
            var lblPrice = new Label
            {
                Width = 170,
                Height = 20,
                Location = new Point(5, 273),
                Text = GetCardPriceText(card.Prices),
                TextAlign = ContentAlignment.MiddleCenter,
                Font = new Font("Segoe UI", 7F, FontStyle.Bold),
                ForeColor = Color.DarkGreen,
                Tag = card
            };
            
            cardPanel.Controls.Add(picBox);
            cardPanel.Controls.Add(lblName);
            cardPanel.Controls.Add(lblPrice);
            
            cardPanel.Click += (s, e) => SelectCard(card);
            picBox.Click += (s, e) => SelectCard(card);
            lblName.Click += (s, e) => SelectCard(card);
            lblPrice.Click += (s, e) => SelectCard(card);
            
            flowLayoutPanelCards.Controls.Add(cardPanel);
            
            // Load thumbnail asynchronously
            string? imageUrl = card.ImageUris?.Small ?? card.CardFaces?.FirstOrDefault()?.ImageUris?.Small;
            if (!string.IsNullOrEmpty(imageUrl))
            {
                _ = LoadCardThumbnail(picBox, imageUrl);
            }
        }
        
        flowLayoutPanelCards.ResumeLayout();
    }

    private string GetCardPriceText(Prices? prices)
    {
        if (prices == null)
            return "N/A";
        
        if (!string.IsNullOrEmpty(prices.Usd))
            return $"${prices.Usd}";
        
        if (!string.IsNullOrEmpty(prices.Eur))
            return $"€{prices.Eur}";
        
        return "N/A";
    }

    private async Task LoadCardThumbnail(PictureBox picBox, string imageUrl)
    {
        try
        {
            var image = await _imageCacheService.GetImageAsync(imageUrl);
            if (image != null && !picBox.IsDisposed)
            {
                picBox.Image = image;
            }
        }
        catch
        {
            // Ignore errors for individual thumbnails
        }
    }

    private async void SelectCard(Card card)
    {
        lblSelectedCardName.Text = card.Name;
        lblSelectedCardValue.Text = FormatCardValue(card.Prices);
        lblSelectedCardType.Text = $"Type: {card.TypeLine}\nMana Cost: {card.ManaCost ?? "N/A"}";
        
        // Display variant information
        var variantInfo = GetVariantDescription(card);
        lblSelectedCardVariant.Text = $"Variant: {variantInfo}\nFinishes: {GetFinishesText(card)}";
        
        lblSelectedCardText.Text = $"Text:\n{card.OracleText ?? "N/A"}";
        lblSelectedCardSet.Text = $"Set: {card.SetName}\nRarity: {card.Rarity}\nCollector #: {card.CollectorNumber}\nArtist: {card.Artist ?? "Unknown"}";
        
        // Load full image
        string? imageUrl = card.ImageUris?.Normal ?? card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
        if (!string.IsNullOrEmpty(imageUrl))
        {
            var image = await _imageCacheService.GetImageAsync(imageUrl);
            if (image != null)
            {
                picSelectedCard.Image = image;
            }
        }
    }

    private string GetFinishesText(Card card)
    {
        if (card.Finishes == null || !card.Finishes.Any())
            return "Unknown";
        
        return string.Join(", ", card.Finishes.Select(f => 
            f switch
            {
                "foil" => "Foil",
                "nonfoil" => "Nonfoil",
                "etched" => "Etched",
                _ => f
            }
        ));
    }

    protected override void OnFormClosing(FormClosingEventArgs e)
    {
        _imageCacheService.ClearCache();
        base.OnFormClosing(e);
    }
}
