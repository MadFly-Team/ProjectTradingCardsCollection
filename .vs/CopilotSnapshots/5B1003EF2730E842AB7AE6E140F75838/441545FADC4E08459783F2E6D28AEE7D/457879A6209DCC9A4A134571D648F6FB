  // Column click handler for sets list sorting
  private void ListViewSets_ColumnClick(object? sender,
                                        ColumnClickEventArgs e) {
    // Determine if clicked column is already the sort column
    if (e.Column == _setListSortColumn) {
      // Reverse the current sort direction
      _setListSortAscending = !_setListSortAscending;
    } else {
      // Set the column number that is to be sorted; default to ascending
      _setListSortColumn = e.Column;
      _setListSortAscending = true;
    }

    // Sort the sets based on the selected column
    SortSetsList();
  }

  private void SortSetsList() {
    if (_allSets.Count == 0)
      return;

    var sortedSets = _setListSortColumn switch {
      0 => _setListSortAscending
               ? _allSets.OrderBy(s => s.Name).ToList()
               : _allSets.OrderByDescending(s => s.Name).ToList(),
      1 => _setListSortAscending
               ? _allSets.OrderBy(s => s.Code).ToList()
               : _allSets.OrderByDescending(s => s.Code).ToList(),
      2 => _setListSortAscending
               ? _allSets.OrderBy(s => s.CardCount).ToList()
               : _allSets.OrderByDescending(s => s.CardCount).ToList(),
      3 => _setListSortAscending
               ? _allSets.OrderBy(s => s.ReleasedAt ?? "").ToList()
               : _allSets.OrderByDescending(s => s.ReleasedAt ?? "").ToList(),
      4 => _setListSortAscending
               ? _allSets.OrderBy(s => s.SetType).ToList()
               : _allSets.OrderByDescending(s => s.SetType).ToList(),
      _ => _allSets
    };

    DisplaySets(sortedSets);
  }

