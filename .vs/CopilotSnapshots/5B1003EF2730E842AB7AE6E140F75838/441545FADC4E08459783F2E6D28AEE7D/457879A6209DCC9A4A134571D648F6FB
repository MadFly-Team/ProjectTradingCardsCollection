  private void LoadSetIconInto(WebBrowser wb, Card card) {
    try {
      var setCode = (card.Set ?? string.Empty).Trim();
      if (string.IsNullOrEmpty(setCode)) { wb.Visible = false; return; }
      var url = $"https://api.scryfall.com/sets/{Uri.EscapeDataString(setCode)}";
      _ = Task.Run(async () => {
        try {
          var set = await _scryfallService.GetSetAsync(setCode);
          if (set?.IconSvgUri is string svgUrl && !string.IsNullOrEmpty(svgUrl)) {
            // Build minimal HTML to size the SVG nicely
            var html = $"<html><head><meta http-equiv='X-UA-Compatible' content='IE=Edge'/><style>html,body{{margin:0;padding:0;background:transparent;}}</style></head><body><img src='{svgUrl}' style='width:100%;height:100%;object-fit:contain;'/></body></html>";
            if (!wb.IsDisposed) {
              wb.Invoke(new Action(() => { wb.DocumentText = html; wb.Visible = true; }));
            }
          } else {
            if (!wb.IsDisposed) wb.Invoke(new Action(() => wb.Visible = false));
          }
        } catch { if (!wb.IsDisposed) wb.Invoke(new Action(() => wb.Visible = false)); }
      });
    } catch { wb.Visible = false; }
  }

  private async Task DisplayCard(Card card) {
    lblCardName.Text = card.Name;
    LoadSetIconInto(wbCardSetIcon, card);
    lblCardValue.Text = FormatCardValue(card.Prices);
    lblManaCost.Text =
        $"Mana Cost: {card.ManaCost ?? "N/A"} (CMC: {card.ConvertedManaCost})";
    lblType.Text = $"Type: {card.TypeLine}";
    lblOracleText.Text = $"Text:\n{card.OracleText ?? "N/A"}";

    if (!string.IsNullOrEmpty(card.Power) &&
        !string.IsNullOrEmpty(card.Toughness))
      lblPowerToughness.Text =
          $"Power/Toughness: {card.Power}/{card.Toughness}";
    else
      lblPowerToughness.Text = "";

    lblSetInfo.Text =
        $"Set: {card.SetName} ({card.Set.ToUpper()}) #{card.CollectorNumber}";
    lblRarity.Text = $"Rarity: {card.Rarity}";
    lblArtist.Text = $"Artist: {card.Artist ?? "Unknown"}";

    if (card.Prices != null) {
      var priceText = "This Version:\n";
      if (!string.IsNullOrEmpty(card.Prices.Usd))
        priceText += $"  USD (Nonfoil): ${card.Prices.Usd}\n";
      if (!string.IsNullOrEmpty(card.Prices.UsdFoil))
        priceText += $"  USD (Foil): ${card.Prices.UsdFoil}\n";
      if (!string.IsNullOrEmpty(card.Prices.Eur))
        priceText += $"  EUR (Nonfoil): €{card.Prices.Eur}\n";
      if (!string.IsNullOrEmpty(card.Prices.EurFoil))
        priceText += $"  EUR (Foil): €{card.Prices.EurFoil}\n";
      if (!string.IsNullOrEmpty(card.Prices.Tix))
        priceText += $"  MTGO Tix: {card.Prices.Tix}\n";

      var variantInfo = GetVariantDescription(card);
      if (variantInfo != "Standard")
        priceText += $"\nVariant Type: {variantInfo}";

      lblPrices.Text = priceText;
    } else {
      lblPrices.Text = "Prices: Not available";
    }

    if (card.Legalities != null && card.Legalities.Any()) {
      var legalText = "Format Legalities:\n";
      foreach (var legality in card.Legalities.Where(l => l.Value == "legal")) {
        legalText += $"  {legality.Key}: {legality.Value}\n";
      }
      lblLegalities.Text = legalText;
    } else {
      lblLegalities.Text = "";
    }

    string? imageUrl = card.ImageUris?.Normal ??
                       card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
    if (!string.IsNullOrEmpty(imageUrl)) {
      var image = await _imageCacheService.GetImageAsync(imageUrl);
      if (image != null) {
        picCardImage.Image = image;
        picCardImage.Visible = true;
        picCardImage.Enabled = true;
        picCardImage.Refresh();
        picCardImage.BringToFront();
      } else {
        picCardImage.Image = null;
        picCardImage.Visible = false;
      }
    } else {
      // show placeholder when no image
      picCardImage.Image = _imageCacheService.GetPlaceholderImage();
      picCardImage.Visible = true;
    }

    // Enable Add to Collection and Load Variants buttons
    btnAddToCollection.Enabled = true;
    btnLoadVariants.Enabled = true;
    try {
      btnLoadVariantsImage.Enabled = true;
    } catch {
    }
  }

  private async Task DisplaySelectedCard(Card card) {
    lblSelectedCardName.Text = card.Name;
    LoadSetIconInto(wbSelectedSetIcon, card);
    lblSelectedCardValue.Text = FormatCardValue(card.Prices);
    lblSelectedCardType.Text =
        $"Type: {card.TypeLine}\nMana Cost: {card.ManaCost ?? "N/A"}";

    var variantInfo = GetVariantDescription(card);
    lblSelectedCardVariant.Text =
        $"Variant: {variantInfo}\nFinishes: {GetFinishesText(card)}";

    lblSelectedCardText.Text = $"Text:\n{card.OracleText ?? "N/A"}";
    lblSelectedCardSet.Text =
        $"Set: {card.SetName}\nRarity: {card.Rarity}\nCollector #: {card.CollectorNumber}\nArtist: {card.Artist ?? "Unknown"}";

    string? imageUrl = card.ImageUris?.Normal ??
                       card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
    if (!string.IsNullOrEmpty(imageUrl)) {
      var image = await _imageCacheService.GetImageAsync(imageUrl);
      if (image != null) {
        picSelectedCard.Image = image;
      }
    }
  }

  // ... rest of the file unchanged ...
}
