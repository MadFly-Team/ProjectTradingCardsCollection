  private async Task LoadAllSets() {
    btnSearchSet.Enabled = false;
    btnSearchSet.Text = "Loading...";

    try {
      _allSets = await _scryfallService.GetAllSetsAsync();
      _allSets = _allSets.OrderByDescending(s => s.ReleasedAt).ToList();

      // Reset sort state when loading new data
      _setListSortColumn = 3;        // Released column
      _setListSortAscending = false; // Descending (newest first)

      DisplaySets(_allSets);
    } catch (Exception ex) {
      MessageBox.Show($"Error loading sets: {ex.Message}", "Error",
                      MessageBoxButtons.OK, MessageBoxIcon.Error);
    } finally {
      btnSearchSet.Enabled = true;
      btnSearchSet.Text = "Reload Sets";
    }
  }

  private void DisplaySets(List<Set> sets) {
    listViewSets.Items.Clear();

    foreach (var set in sets) {
      var item = new ListViewItem(set.Name);
      item.SubItems.Add(set.Code.ToUpper());
      item.SubItems.Add(set.CardCount.ToString());
      item.SubItems.Add(set.ReleasedAt ?? "N/A");
      item.SubItems.Add(set.SetType);
      item.Tag = set;
      listViewSets.Items.Add(item);
    }
  }

  private void FilterSets() {
    if (_allSets.Count == 0)
      return;

    var filter = txtSearchSet.Text.Trim().ToLower();
    if (string.IsNullOrWhiteSpace(filter)) {
      // If there's an active sort, apply it
      if (_setListSortColumn >= 0) {
        SortSetsList();
      } else {
        DisplaySets(_allSets);
      }
    } else {
      var filtered = _allSets
                         .Where(s => s.Name.ToLower().Contains(filter) ||
                                     s.Code.ToLower().Contains(filter))
                         .ToList();
      DisplaySets(filtered);
    }
  }

