  private string FormatCardValue(Prices? prices) {
    if (prices == null)
      return "Current Value: Not Available";

    var pricesList = new List<string>();

    if (!string.IsNullOrEmpty(prices.Usd))
      pricesList.Add($"${prices.Usd} USD");

    if (!string.IsNullOrEmpty(prices.UsdFoil))
      pricesList.Add($"${prices.UsdFoil} USD Foil");

    if (!string.IsNullOrEmpty(prices.Eur))
      pricesList.Add($"€{prices.Eur} EUR");

    if (pricesList.Count == 0)
      return "Current Value: Not Available";

    return $"?? Current Value: {string.Join(" | ", pricesList)}";
  }

