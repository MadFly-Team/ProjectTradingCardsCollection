  private async void CollectionsPollTimer_Tick(object? sender, EventArgs e) {
    if (_isPollingCollections)
      return;
    _isPollingCollections = true;
    try {
      var reloaded = await _collectionService.ReloadIfChangedAsync();
      if (reloaded) {
        HandleCollectionsChanged();
      }
    } catch {
      // swallow polling exceptions
    } finally {
      _isPollingCollections = false;
    }
  }

  private void CollectionService_CollectionsChanged(object? sender,
                                                    EventArgs e) {
    if (this.IsDisposed)
      return;
    if (this.InvokeRequired) {
      try {
        this.BeginInvoke((Action)(() => HandleCollectionsChanged()));
      } catch {
      }
    } else {
      HandleCollectionsChanged();
    }
  }

  private void HandleCollectionsChanged() {
    try {
      // Refresh the main collections list
      RefreshCollectionsTab();

      // If a collection was open, reload its latest data and refresh UI
      if (_currentCollection != null) {
        var updated = _collectionService.GetCollection(_currentCollection.Id);
        if (updated != null) {
          _currentCollection = updated;
          DisplayCollectionDetails(_currentCollection);

          // If a folder was selected, try to restore selection and refresh its
          // cards
          if (_currentFolder != null) {
            var folderMatch = _currentCollection.Folders.FirstOrDefault(
                f => f.Id == _currentFolder.Id);
            if (folderMatch != null) {
              _currentFolder = folderMatch;
              // Select the folder node in the tree view
              foreach (TreeNode root in treeViewCollectionFolders.Nodes) {
                foreach (TreeNode node in root.Nodes) {
                  if (node.Tag is CollectionFolder cf &&
                      cf.Id == _currentFolder.Id) {
                    treeViewCollectionFolders.SelectedNode = node;
                    node.Expand();
                    DisplayFolderCards(_currentFolder);
                    break;
                  }
                }
              }
            } else {
              // folder removed, clear selection
              _currentFolder = null;
              listViewCollectionCards.Items.Clear();
            }
          }
        } else {
          // collection was removed
          _currentCollection = null;
          _currentFolder = null;
          listViewCollectionCards.Items.Clear();
          lblCollectionName.Text = "Select a collection";
          lblCollectionDescription.Text = "";
          lblCollectionStats.Text = "";
        }
      }
    } catch {
      // swallow UI refresh errors
    }
  }

