  // Set Cards Tab Events
  private async Task LoadSetCards(Set set) {
    lblCurrentSet.Text = $"Loading cards from {set.Name}...";

    try {
      var progress = new Progress<PageProgress>(p => {
        if (p.Total.HasValue && p.Total.Value > 0) {
          prgLoadingSetCards.Style = ProgressBarStyle.Continuous;
          prgLoadingSetCards.Maximum = p.Total.Value;
          prgLoadingSetCards.Value =
              Math.Min(prgLoadingSetCards.Maximum, p.Loaded);
        } else {
          prgLoadingSetCards.Style = ProgressBarStyle.Marquee;
        }

        lblCurrentSet.Text =
            $"{set.Name} ({set.Code.ToUpper()}) - Loading {p.Loaded}{(p.Total.HasValue ? $"/{p.Total.Value}" : string.Empty)} cards (page {p.Page})";
      });

      _currentSetCards =
          await _scryfallService.GetCardsBySetAsync(set.Code, progress);
      lblCurrentSet.Text =
          $"{set.Name} ({set.Code.ToUpper()}) - {_currentSetCards.Count} cards";

      _isAscendingSort = true;
      btnToggleSortOrder.Text = "? Ascending";

      // Switch to List view by default for set cards
      cmbViewMode.SelectedIndex = 1; // 0: Thumbnails, 1: List

      await ApplySortAndDisplay();
    } catch (Exception ex) {
      MessageBox.Show($"Error loading cards: {ex.Message}", "Error",
                      MessageBoxButtons.OK, MessageBoxIcon.Error);
      lblCurrentSet.Text = $"Error loading {set.Name}";
    } finally {
      prgLoadingSetCards.Visible = false;
      btnViewSetCards.Enabled = true;
    }
  }

  private async Task ApplySortAndDisplay() {
    var sortedCards = SortCards(_currentSetCards);
    UpdateSortOrderLabel();
    await DisplaySetCards(sortedCards);
  }

