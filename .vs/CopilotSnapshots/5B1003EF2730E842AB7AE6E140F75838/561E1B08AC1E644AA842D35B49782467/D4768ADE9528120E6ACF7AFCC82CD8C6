  private void TabBrowseSets_Resize(object? sender, EventArgs e) {
    if (tabBrowseSets.Width > 0 && tabBrowseSets.Height > 0) {
      // Calculate available height (from top of list to bottom of tab, minus
      // margins)
      int availableHeight =
          tabBrowseSets.Height - listViewSets.Top - 20; // 20px bottom margin

      if (availableHeight > 200) // Minimum reasonable height
      {
        listViewSets.Height = availableHeight;
        panelSetDetails.Height = availableHeight;
      }

      // Adjust set details panel width based on tab width
      int availableWidth = tabBrowseSets.Width - listViewSets.Right - 40;
      if (availableWidth > 400) {
        panelSetDetails.Width = availableWidth;
      }
    }
  }

  private void TabSetCards_Resize(object? sender, EventArgs e) {
    if (tabSetCards.Width > 0 && tabSetCards.Height > 0) {
      // Calculate available space
      int totalWidth = tabSetCards.Width - 40;
      int minCardInfoWidth = 450;
      int cardInfoWidth = 680;

      int actualCardInfoWidth =
          Math.Max(minCardInfoWidth, Math.Min(cardInfoWidth, totalWidth - 250));
      int flowPanelWidth = totalWidth - actualCardInfoWidth - 20;

      if (flowPanelWidth < 190) {
        flowPanelWidth = 190;
        actualCardInfoWidth = totalWidth - flowPanelWidth - 20;
      }

      flowLayoutPanelCards.Width = flowPanelWidth;
      listViewSetCards.Width = flowPanelWidth;
      panelCardInfo.Location =
          new Point(flowLayoutPanelCards.Right + 20, panelCardInfo.Top);
      panelCardInfo.Width = actualCardInfoWidth;

      int availableHeight = tabSetCards.Height - flowLayoutPanelCards.Top - 20;
      if (availableHeight > 400) {
        flowLayoutPanelCards.Height = availableHeight;
        listViewSetCards.Height = availableHeight;
        panelCardInfo.Height = availableHeight;
      }
    }
  }

