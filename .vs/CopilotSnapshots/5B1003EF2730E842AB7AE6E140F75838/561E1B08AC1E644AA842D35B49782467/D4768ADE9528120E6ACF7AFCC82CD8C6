  private Size GetThumbSizePx() {
    return _thumbSizeIndex switch {
      0 => new Size(120, 168), // Small 5:7 ratio approx
      1 => new Size(170, 237), // Medium (current default)
      2 => new Size(220, 306), // Large
      _ => new Size(170, 237)
    };
  }

  private Size GetCardTileSize() {
    var thumb = GetThumbSizePx();
    int panelWidth = thumb.Width + 10;
    int panelHeight = thumb.Height + 63; // name+price areas
    // Ensure min bounds
    panelWidth = Math.Max(panelWidth, 180);
    panelHeight = Math.Max(panelHeight, 300);
    return new Size(panelWidth, panelHeight);
  }

  private async Task DisplaySetCards(List<Card> cards) {
    // If List view is active, skip creating thumbnail controls
    if (listViewSetCards.Visible) {
      PopulateSetCardsListView(cards);
      return;
    }

    flowLayoutPanelCards.SuspendLayout();

    // Dispose existing controls to free handles
    if (flowLayoutPanelCards.Controls.Count > 0) {
      var old = flowLayoutPanelCards.Controls.Cast<Control>().ToArray();
      flowLayoutPanelCards.Controls.Clear();
      foreach (var c in old)
        c.Dispose();
    }

    var thumb = GetThumbSizePx();
    var tile = GetCardTileSize();

    foreach (var card in cards) {
      var cardPanel = new Panel {
        Width = tile.Width,      Height = tile.Height,
        Margin = new Padding(5), BorderStyle = BorderStyle.FixedSingle,
        Cursor = Cursors.Hand,   Tag = card
      };

      var picBox =
          new PictureBox { Width = thumb.Width, Height = thumb.Height,
                           Location = new Point(5, 5),
                           SizeMode = PictureBoxSizeMode.Zoom, Tag = card };

      var lblName = new Label { Width = tile.Width - 10,
                                Height = 25,
                                Location = new Point(5, thumb.Height + 8),
                                Text = $"{card.CollectorNumber} - {card.Name}",
                                TextAlign = ContentAlignment.MiddleCenter,
                                Font = _tileNameFont,
                                Tag = card };

      var lblPrice = new Label { Width = tile.Width - 10,
                                 Height = 20,
                                 Location = new Point(5, thumb.Height + 33),
                                 Text = GetCardPriceText(card.Prices),
                                 TextAlign = ContentAlignment.MiddleCenter,
                                 Font = _tilePriceFont,
                                 ForeColor = Color.DarkGreen,
                                 Tag = card };

      cardPanel.Controls.Add(picBox);
      cardPanel.Controls.Add(lblName);
      cardPanel.Controls.Add(lblPrice);

      cardPanel.Click += (s, e) => SelectCard(card);
      picBox.Click += (s, e) => SelectCard(card);
      lblName.Click += (s, e) => SelectCard(card);
      lblPrice.Click += (s, e) => SelectCard(card);

      flowLayoutPanelCards.Controls.Add(cardPanel);

      string? imageUrl = card.ImageUris?.Small ??
                         card.CardFaces?.FirstOrDefault()?.ImageUris?.Small;
      if (!string.IsNullOrEmpty(imageUrl)) {
        _ = LoadCardThumbnail(picBox, imageUrl);
      }
    }

    flowLayoutPanelCards.ResumeLayout();
  }

  private void PopulateSetCardsListView(List<Card> cards) {
    listViewSetCards.BeginUpdate();
    listViewSetCards.Items.Clear();
    foreach (var card in cards) {
      var item = new ListViewItem(card.CollectorNumber);
      item.SubItems.Add(card.Name);
      item.SubItems.Add(card.Rarity);
      item.SubItems.Add(GetCardPriceText(card.Prices));
      item.SubItems.Add(card.SetName);
      item.Tag = card;
      listViewSetCards.Items.Add(item);
    }
    listViewSetCards.EndUpdate();
    listViewSetCards.SelectedIndexChanged -=
        ListViewSetCards_SelectedIndexChanged;
    listViewSetCards.SelectedIndexChanged +=
        ListViewSetCards_SelectedIndexChanged;
  }

