  private void LoadSetIconInto(WebBrowser wb, Card card) {
    try {
      var rawCode = (card.Set ?? string.Empty).Trim();
      var setCode = string.IsNullOrEmpty(rawCode) ? string.Empty
                                                  : rawCode.ToLowerInvariant();
      if (string.IsNullOrEmpty(setCode)) {
        wb.Visible = false;
        return;
      }

      // If HTML is cached for this set code, use it immediately
      if (_setIconHtmlCache.TryGetValue(setCode, out var cachedHtml)) {
        try {
          wb.DocumentText = cachedHtml;
          wb.Visible = true;
          wb.BringToFront();
        } catch {
        }
      }

      var requestId = Guid.NewGuid().ToString();
      try {
        wb.Tag = requestId;
      } catch {
      }

      _ = Task.Run(async () => {
        string? svgUrl = null;
        string? svgMarkup = null;
        try {
          var set = await _scryfallService.GetSetAsync(setCode);
          svgUrl = set?.IconSvgUri;

          if (!string.IsNullOrEmpty(svgUrl)) {
            try {
              using var http = new System.Net.Http.HttpClient();
              http.Timeout = TimeSpan.FromSeconds(10);
              svgMarkup = await http.GetStringAsync(svgUrl);
            } catch {
              svgMarkup = null;
            }
          }

          if (wb.IsDisposed)
            return;

          wb.Invoke(new Action(() => {
            if (wb.IsDisposed)
              return;
            if (!Equals(wb.Tag, requestId))
              return;

            string html;
            if (!string.IsNullOrEmpty(svgMarkup)) {
              html =
                  "<html><head><meta http-equiv='X-UA-Compatible' " +
                  "content='IE=edge'/>" +
                  "<style>html,body{margin:0;padding:0;background:" +
                  "transparent;width:100%;height:100%;overflow:hidden} " +
                  "svg{width:100%;height:100%;display:block}</style></head>" +
                  "<body>" + svgMarkup + "</body></html>";
            } else if (!string.IsNullOrEmpty(svgUrl)) {
              string htmlDataUrl;
              try {
                using var enc = new System.Net.WebClient();
                var raw = enc.DownloadString(svgUrl);
                string base64 = Convert.ToBase64String(
                    System.Text.Encoding.UTF8.GetBytes(raw));
                string dataUrl = "data:image/svg+xml;base64," + base64;
                htmlDataUrl =
                    "<html><head><meta http-equiv='X-UA-Compatible' " +
                    "content='IE=edge'/>" +
                    "<style>html,body{margin:0;padding:0;background:" +
                    "transparent;width:100%;height:100%;overflow:hidden}</" +
                    "style></head>" +
                    $"<body><img id='icon' src='{dataUrl}' onerror=\"this.onerror=null;this.src='{svgUrl}';\" style='display:block;width:100%;height:100%' /></body></html>";
              } catch {
                htmlDataUrl =
                    "<html><head><meta http-equiv='X-UA-Compatible' " +
                    "content='IE=edge'/>" +
                    "<style>html,body{margin:0;padding:0;background:" +
                    "transparent;width:100%;height:100%;overflow:hidden}</" +
                    "style></head>" +
                    $"<body><img src='{svgUrl}' style='display:block;width:100%;height:100%' /></body></html>";
              }
              html = htmlDataUrl;
            } else {
              string code = setCode.ToUpperInvariant();
              html =
                  "<html><head><meta http-equiv='X-UA-Compatible' " +
                  "content='IE=edge'/>" +
                  "<style>html,body{margin:0;padding:0;background:" +
                  "transparent;width:100%;height:100%;overflow:hidden} " +
                  ".badge{width:100%;height:100%;display:flex;align-items:" +
                  "center;justify-content:center;font:12px Segoe " +
                  "UI,Arial;color:#333;border:1px solid " +
                  "#ccc;border-radius:4px;background:#f5f5f5}</style></head>" +
                  $"<body><div class='badge'>{code}</div></body></html>";
            }

            // Cache resulting HTML for this set code to reuse on variant
            // selection
            try {
              _setIconHtmlCache[setCode] = html;
            } catch {
            }

            WebBrowserDocumentCompletedEventHandler? handler = null;
            handler = (s, e) => {
              try {
                if (wb.IsDisposed)
                  return;
                if (!Equals(wb.Tag, requestId))
                  return;
                wb.DocumentCompleted -= handler;
                try {
                  wb.DocumentText = html;
                } catch {
                  ShowBadge(wb, setCode);
                  return;
                }
                wb.AllowNavigation = false;
                wb.ScrollBarsEnabled = false;
                wb.Visible = true;
                try {
                  wb.BringToFront();
                } catch {
                }
                wb.Refresh();
              } catch {
                ShowBadge(wb, setCode);
              }
            };

            try {
              wb.DocumentCompleted -= handler;
            } catch {
            }
            try {
              wb.DocumentCompleted += handler;
            } catch {
              handler = null;
            }
            try {
              wb.Navigate("about:blank?rid=" + requestId);
            } catch {
              // If navigate fails, set directly
              try { wb.DocumentText = html; wb.Visible = true; wb.BringToFront(); } catch { ShowBadge(wb, setCode); }
            }
          });
        } catch {
          if (!wb.IsDisposed)
            wb.Invoke(new Action(() => { ShowBadge(wb, setCode); }));
        }
      });
    } catch {
      ShowBadge(wb, (card.Set ?? string.Empty));
    }
  }

  private void ShowBadge(WebBrowser wb, string code) {
    try {
      if (wb.IsDisposed)
        return;
      string safe = (code ?? string.Empty).Trim().ToUpperInvariant();
      var html =
          "<html><head><meta http-equiv='X-UA-Compatible' content='IE=edge'/>" +
          "<style>html,body{margin:0;padding:0;background:transparent;width:" +
          "100%;height:100%;overflow:hidden} " +
          ".badge{width:100%;height:100%;display:flex;align-items:center;" +
          "justify-content:center;font:12px Segoe " +
          "UI,Arial;color:#333;border:1px solid " +
          "#ccc;border-radius:4px;background:#f5f5f5}</style></head>" +
          $"<body><div class='badge'>{safe}</div></body></html>";
      try {
        wb.DocumentText = html;
      } catch {
      }
      wb.AllowNavigation = false;
      wb.ScrollBarsEnabled = false;
      wb.Visible = true;
      try {
        wb.BringToFront();
      } catch {
      }
    } catch {
      try {
        wb.Visible = false;
      } catch {
      }
    }
  }
