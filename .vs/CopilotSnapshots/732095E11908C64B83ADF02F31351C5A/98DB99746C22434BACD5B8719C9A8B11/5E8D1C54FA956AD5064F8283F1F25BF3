  private async Task SearchCard() {
    var cardName = txtSearchCard.Text.Trim();
    if (string.IsNullOrWhiteSpace(cardName)) {
      MessageBox.Show("Please enter a card name.", "Search Card",
                      MessageBoxButtons.OK, MessageBoxIcon.Information);
      return;
    }

    btnSearchCard.Enabled = false;
    btnSearchCard.Text = "Searching...";

    try {
      var card = await _pokemonCardService.GetCardByNameAsync(cardName);

      if (card != null) {
        _currentCard = card;
        await DisplayCard(card);
        btnLoadVariants.Enabled = true;
      } else {
        MessageBox.Show("Card not found.", "Search Card", MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
        ClearCardDisplay();
      }
    } catch (Exception ex) {
      MessageBox.Show($"Error searching for card: {ex.Message}", "Error",
                      MessageBoxButtons.OK, MessageBoxIcon.Error);
    } finally {
      btnSearchCard.Enabled = true;
      btnSearchCard.Text = "Search";
    }
  }

