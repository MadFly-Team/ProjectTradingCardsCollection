  private void ReflowSelectedCardInfo() {
    if (panelCardInfo.Width <= 0 || panelCardInfo.Height <= 0)
      return;

    var scrollPosition = panelCardInfo.AutoScrollPosition;
    panelCardInfo.AutoScrollPosition = Point.Empty;
    panelCardInfo.SuspendLayout();

    // Base positions relative to image
    int left = picSelectedCard.Right + 20;
    int top = 20;
    int rightPadding = 12 + SystemInformation.VerticalScrollBarWidth;
    int iconW = wbSelectedSetIcon.Width > 0 ? wbSelectedSetIcon.Width : 24;
    int availableTextWidth =
        Math.Max(100, panelCardInfo.ClientSize.Width - (left + iconW + 6) -
                          rightPadding);

    // Icon next to title
    try {
      wbSelectedSetIcon.Location = new Point(left, top + 2);
    } catch {
    }

    // Title
    ConfigureWrappingLabel(lblSelectedCardName,
                           new Point(left + iconW + 6, top),
                           availableTextWidth);
    top = lblSelectedCardName.Bottom + 6;

    // Value
    ConfigureWrappingLabel(lblSelectedCardValue, new Point(left, top),
                           panelCardInfo.ClientSize.Width - left -
                               rightPadding);
    top = lblSelectedCardValue.Bottom + 6;

    // Buttons (keep same sizes)
    try {
      btnLoadSelectedVariants.Location = new Point(left, top);
      btnAddSelectedToCollection.Location =
          new Point(left + btnLoadSelectedVariants.Width + 8, top);
    } catch {
    }
    top += Math.Max(btnLoadSelectedVariants.Height,
                    btnAddSelectedToCollection.Height) +
           8;

    // Type and Variant
    ConfigureWrappingLabel(lblSelectedCardType, new Point(left, top),
                           panelCardInfo.ClientSize.Width - left -
                               rightPadding);
    top = lblSelectedCardType.Bottom + 6;

    ConfigureWrappingLabel(lblSelectedCardVariant, new Point(left, top),
                           panelCardInfo.ClientSize.Width - left -
                               rightPadding);
    top = lblSelectedCardVariant.Bottom + 6;

    // Oracle text
    ConfigureWrappingLabel(lblSelectedCardText, new Point(left, top),
                           panelCardInfo.ClientSize.Width - left -
                               rightPadding);
    top = lblSelectedCardText.Bottom + 6;

    // Set details
    ConfigureWrappingLabel(lblSelectedCardSet, new Point(left, top),
                           panelCardInfo.ClientSize.Width - left -
                               rightPadding);
    top = lblSelectedCardSet.Bottom + 10;

    // Keep the variants section below both the image and the full details.
    int varLeft = picSelectedCard.Left;
    int varTop = Math.Max(picSelectedCard.Bottom + 8, top);
    ConfigureWrappingLabel(lblSelectedVariantsHeader,
                           new Point(varLeft, varTop),
                           panelCardInfo.ClientSize.Width - varLeft - rightPadding);
    listViewSelectedVariants.Location =
        new Point(varLeft, lblSelectedVariantsHeader.Bottom + 5);
    listViewSelectedVariants.Size = new Size(
        Math.Max(100, panelCardInfo.ClientSize.Width - varLeft - rightPadding),
        Math.Max(180, panelCardInfo.ClientSize.Height - listViewSelectedVariants.Top - 12));
    panelCardInfo.AutoScrollMinSize = new Size(0, listViewSelectedVariants.Bottom + 12);

    panelCardInfo.ResumeLayout();
    panelCardInfo.AutoScrollPosition = new Point(-scrollPosition.X, -scrollPosition.Y);
  }

  private static void ConfigureWrappingLabel(Label label, Point location,
                                             int maxWidth) {
    try {
      label.AutoSize = true;
      label.MaximumSize = new Size(Math.Max(50, maxWidth), 0);
      label.Location = location;
    } catch {
    }
  }

  private void CollectionService_CollectionsChanged(object? sender,
                                                    EventArgs e) {
    if (this.IsDisposed)
      return;
    if (this.InvokeRequired) {
      try {
        this.BeginInvoke((Action)(() => HandleCollectionsChanged()));
      } catch {
      }
    } else {
      HandleCollectionsChanged();
    }
  }

  private void HandleCollectionsChanged() {
    try {
      // Refresh the main collections list
      RefreshCollectionsTab();

      // If a collection was open, reload its latest data and refresh UI
      if (_currentCollection != null) {
        var updated = _collectionService.GetCollection(_currentCollection.Id);
        if (updated != null) {
          _currentCollection = updated;
          DisplayCollectionDetails(_currentCollection);

          // If a folder was selected, try to restore selection and refresh its
          // cards
          if (_currentFolder != null) {
            var folderMatch = _currentCollection.Folders.FirstOrDefault(
                f => f.Id == _currentFolder.Id);
            if (folderMatch != null) {
              _currentFolder = folderMatch;
              // Select the folder node in the tree view
              foreach (TreeNode root in treeViewCollectionFolders.Nodes) {
                foreach (TreeNode node in root.Nodes) {
                  if (node.Tag is CollectionFolder cf &&
                      cf.Id == _currentFolder.Id) {
                    treeViewCollectionFolders.SelectedNode = node;
                    node.Expand();
                    DisplayFolderCards(_currentFolder);
                    break;
                  }
                }
              }
            } else {
              // folder removed, clear selection
              _currentFolder = null;
              listViewCollectionCards.Items.Clear();
            }
          }
        } else {
          // collection was removed
          _currentCollection = null;
          _currentFolder = null;
          listViewCollectionCards.Items.Clear();
          lblCollectionName.Text = "Select a collection";
          lblCollectionDescription.Text = "";
          lblCollectionStats.Text = "";
        }
      }
    } catch {
      // swallow UI refresh errors
    }
  }

