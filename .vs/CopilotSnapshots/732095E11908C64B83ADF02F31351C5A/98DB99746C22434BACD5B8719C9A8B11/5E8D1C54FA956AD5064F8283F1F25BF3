  private async void MainForm_LoadGbpRates(object? sender, EventArgs e) {
    try {
      await _gbpPrices.LoadRatesAsync();
    } catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) {
      if (!IsDisposed)
        MessageBox.Show(this, $"GBP conversion is unavailable. Original card prices are still shown.\n{ex.Message}",
                        "Exchange rates", MessageBoxButtons.OK, MessageBoxIcon.Warning);
    }

    if (IsDisposed)
      return;
    if (_currentCard != null) {
      lblCardValue.Text = FormatCardValue(_currentCard.Prices);
      lblPrices.Text = FormatDetailedPrices(_currentCard);
    }
    if (_currentSelectedSetCard != null) {
      lblSelectedCardValue.Text = FormatCardValue(_currentSelectedSetCard.Prices);
      ReflowSelectedCardInfo();
    }
    if (_currentCardVariants.Count > 0)
      DisplayVariants(_currentCardVariants);
    if (_currentSelectedCardVariants.Count > 0)
      DisplaySelectedCardVariants(_currentSelectedCardVariants);
    if (_currentSetCards.Count > 0)
      await ApplySortAndDisplay();
    if (_currentCollection != null)
      UpdateCollectionValue(_currentCollection);
    if (treeViewCollectionFolders.SelectedNode?.Tag is CollectionFolder folder)
      DisplayFolderCards(folder);
  }

