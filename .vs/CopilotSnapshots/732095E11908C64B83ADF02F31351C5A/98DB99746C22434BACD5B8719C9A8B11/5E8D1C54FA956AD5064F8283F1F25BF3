  private List<Card> SortCards(List<Card> cards) {
    var sortBy = cmbSortBy.SelectedIndex;

    IOrderedEnumerable<Card> sorted = sortBy switch {
      0 =>
          _isAscendingSort
              ? cards.OrderBy(c => GetNumericCollectorNumber(c.CollectorNumber))
              : cards.OrderByDescending(
                    c => GetNumericCollectorNumber(c.CollectorNumber)),
      1 => _isAscendingSort
               ? cards.OrderBy(c => GetCardPrice(c.Prices))
               : cards.OrderByDescending(c => GetCardPrice(c.Prices)),
      2 => _isAscendingSort
               ? cards.OrderBy(c => GetRarityOrder(c.Rarity))
               : cards.OrderByDescending(c => GetRarityOrder(c.Rarity)),
      3 => _isAscendingSort ? cards.OrderBy(c => c.Name)
                            : cards.OrderByDescending(c => c.Name),
      _ => cards.OrderBy(c => GetNumericCollectorNumber(c.CollectorNumber))
    };

    return sorted.ToList();
  }

  private int GetNumericCollectorNumber(string collectorNumber) {
    // Extract numeric part from collector number (e.g., "123a" -> 123)
    var numericPart =
        new string(collectorNumber.TakeWhile(char.IsDigit).ToArray());
    return int.TryParse(numericPart, out int result) ? result : int.MaxValue;
  }

  private decimal GetCardPrice(Prices? prices) {
    if (GbpPriceService.TryParsePrice(prices?.Usd, out var usdPrice))
      return usdPrice;
    if (GbpPriceService.TryParsePrice(prices?.Eur, out var eurPrice))
      return eurPrice * 1.1m; // Approximate conversion
    if (GbpPriceService.TryParsePrice(prices?.UsdFoil, out var holoUsdPrice))
      return holoUsdPrice;
    if (GbpPriceService.TryParsePrice(prices?.EurFoil, out var holoEurPrice))
      return holoEurPrice * 1.1m;

    return 0;
  }

  private int GetRarityOrder(string rarity) {
    return rarity.ToLower() switch { "common" => 1,  "uncommon" => 2,
                                     "rare" => 3,    "mythic" => 4,
                                     "special" => 5, "bonus" => 6,
                                     _ => 0 };
  }

