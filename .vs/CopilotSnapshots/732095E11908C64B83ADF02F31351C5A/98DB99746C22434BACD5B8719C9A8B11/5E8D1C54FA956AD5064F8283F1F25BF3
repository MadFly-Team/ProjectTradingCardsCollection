                    try {
                      wb.NavigateToString(html);
                      wb.Visible = true;
                      try {
                        wb.BringToFront();
                      } catch {
                      }
                      wb.Refresh();
                    } catch {
                      try {
                        wb.Visible = false;
                      } catch {
                      }
                    }
                  } else {
                    try {
                      wb.Visible = false;
                    } catch {
                    }
                  }
                },
                TaskScheduler.FromCurrentSynchronizationContext());
          } catch {
            try {
              wb.Visible = false;
            } catch {
            }
          }
        }));
      });
    } catch {
