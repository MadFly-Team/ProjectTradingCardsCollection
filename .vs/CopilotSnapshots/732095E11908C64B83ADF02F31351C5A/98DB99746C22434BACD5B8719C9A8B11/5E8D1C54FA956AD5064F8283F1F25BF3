  public void ApplyTheme(ColorTheme theme) {
    // Apply to main form
    this.BackColor = theme.BackColor;

    // Apply to menu strip
    menuStrip.BackColor = theme.BackColor;
    menuStrip.ForeColor = theme.ForeColor;

    // Apply to all tab pages
    foreach (TabPage tab in tabControl.TabPages) {
      tab.BackColor = theme.BackColor;
      tab.ForeColor = theme.ForeColor;
    }

    tabControl.BackColor = theme.BackColor;

    // Search Card Tab
    ApplyThemeToControl(txtSearchCard, theme);
    ApplyThemeToButton(btnSearchCard, theme);
    ApplyThemeToButton(btnLoadVariants, theme);
    panelCardDetails.BackColor = theme.PanelBackColor;
    ApplyThemeToLabels(panelCardDetails, theme);
    listViewVariants.BackColor = theme.ControlBackColor;
    listViewVariants.ForeColor = theme.ForeColor;

    // Browse Sets Tab
    ApplyThemeToControl(txtSearchSet, theme);
    ApplyThemeToButton(btnSearchSet, theme);
    listViewSets.BackColor = theme.ControlBackColor;
    listViewSets.ForeColor = theme.ForeColor;
    panelSetDetails.BackColor = theme.PanelBackColor;
    ApplyThemeToLabels(panelSetDetails, theme);
    ApplyThemeToButton(btnViewSetCards, theme);

    // Set Cards Tab
    ApplyThemeToLabels(tabSetCards, theme);
    ApplyThemeToControl(cmbSortBy, theme);
    ApplyThemeToButton(btnToggleSortOrder, theme);
    flowLayoutPanelCards.BackColor = theme.PanelBackColor;
    panelCardInfo.BackColor = theme.PanelBackColor;
    ApplyThemeToLabels(panelCardInfo, theme);
    ApplyThemeToButton(btnLoadSelectedVariants, theme);
    listViewSelectedVariants.BackColor = theme.ControlBackColor;
    listViewSelectedVariants.ForeColor = theme.ForeColor;

    // Refresh the form
    this.Refresh();
  }

  private void ApplyThemeToControl(Control control, ColorTheme theme) {
    control.BackColor = theme.ControlBackColor;
    control.ForeColor = theme.ForeColor;
  }

  private void ApplyThemeToButton(Button button, ColorTheme theme) {
    button.BackColor = theme.ButtonBackColor;
    button.ForeColor = theme.ButtonForeColor;
    button.FlatStyle = FlatStyle.Standard;
  }

  private void ApplyThemeToLabels(Control parent, ColorTheme theme) {
    foreach (Control control in parent.Controls) {
      if (control is Label label) {
        // Preserve special label colors (like value in green)
        if (label == lblCardValue || label == lblSelectedCardValue) {
          // Keep the green color for value labels
          continue;
        }
        label.ForeColor = theme.ForeColor;
      } else if (control.HasChildren) {
        ApplyThemeToLabels(control, theme);
      }
    }
  }

