  private static Color GetRarityColor(string rarity) {
    switch ((rarity ?? string.Empty).Trim().ToLowerInvariant()) {
    case "common":
      return Color.DimGray;
    case "uncommon":
      return Color.Silver;
    case "rare":
      return Color.DarkGoldenrod;
    case "mythic":
      return Color.OrangeRed;
    case "special":
      return Color.MediumPurple;
    case "bonus":
      return Color.DeepPink;
    default:
      return Color.Gray;
    }
  }

  private static string ColorToHex(Color color) {
    return $"#{color.R:X2}{color.G:X2}{color.B:X2}";
  }

  private static string PrepareInlineSvgHtml(string rawSvg, string colorHex) {
    try {
      var sb = new StringBuilder(rawSvg.Length + 256);
      using (var reader = new StringReader(rawSvg)) {
        string ? line;
        while ((line = reader.ReadLine()) != null) {
          if (line.StartsWith("<?xml", StringComparison.OrdinalIgnoreCase))
            continue;
          if (line.StartsWith("<!DOCTYPE", StringComparison.OrdinalIgnoreCase))
            continue;
          sb.AppendLine(line);
        }
      }

      var cleaned = sb.ToString();
      // Ensure root svg exists and doesn't have inline width/height overriding
      // our container Inject style to force fill to currentColor
      var style =
          "<style>html,body,#c{margin:0;padding:0;background:transparent;" +
          "width:" +
          "100%;height:100%;overflow:hidden} svg{width:100%;height:100%} svg " +
          "*{fill:currentColor !important}</style>";
      var html = new StringBuilder(cleaned.Length + 512);
      html.Append("<html><head>");
      html.Append(style);
      html.Append("</head><body><div id='c' style='color:");
      html.Append(colorHex);
      html.Append("'>");
      html.Append(cleaned);
      html.Append("</div></body></html>");
      return html.ToString();
    } catch {
      return "<html><head><style>html,body{margin:0;padding:0;background:" +
             "transparent;width:100%;height:100%;overflow:hidden}</style></" +
             "head><body></body></html>";
    }
  }
