  private void LoadSetIconInto(WebView2 wb, Card card) {
    try {
      var rawCode = (card.Set ?? string.Empty).Trim();
      var setCode = string.IsNullOrEmpty(rawCode) ? string.Empty
                                                  : rawCode.ToLowerInvariant();
      if (string.IsNullOrEmpty(setCode)) {
        try {
          wb.Visible = false;
        } catch {
        }
        return;
      }

      var requestId = Guid.NewGuid().ToString();

      _ = Task.Run(async () => {
        string? svgUrl = null;
        string? svgContent = null;
        try {
          var set = await _pokemonCardService.GetSetAsync(setCode);
          svgUrl = set?.IconSvgUri;
          if (!string.IsNullOrEmpty(svgUrl) &&
              svgUrl.StartsWith("http:", StringComparison.OrdinalIgnoreCase)) {
            svgUrl = "https:" + svgUrl.Substring(5);
          }
          if (!string.IsNullOrEmpty(svgUrl)) {
            try {
              svgContent = await _iconHttp.GetStringAsync(svgUrl);
            } catch {
              svgContent = null;
            }
          }
        } catch {
          svgUrl = null;
        }

        if (wb.IsDisposed)
          return;

        wb.Invoke(new Action(() => {
          if (wb.IsDisposed)
            return;

          var urlLower = (svgUrl ?? string.Empty).ToLowerInvariant();
          bool urlLooksBlank = urlLower.Contains("blank.svg") ||
                               urlLower.Contains("blanlk.svg") ||
                               urlLower.Contains("blank");
          if (string.IsNullOrEmpty(svgUrl) || urlLooksBlank) {
            try {
              wb.Visible = false;
            } catch {
            }
            return;
          }

          string html;
          var rarityColor = GetRarityColor(card.Rarity);
          var rarityHex = ColorToHex(rarityColor);
          if (!string.IsNullOrWhiteSpace(svgContent)) {
            var inline = PrepareInlineSvgHtml(svgContent!, rarityHex);
            html = inline;
          } else {
            string sep = svgUrl!.Contains("?") ? "&" : "?";
            string bustedUrl = svgUrl + sep + "rid=" + requestId;
            string safeUrl = System.Web.HttpUtility.HtmlEncode(bustedUrl);
            html =
                "<html><head>" +
                "<style>html,body{margin:0;padding:0;background:transparent;" +
                "width:100%;height:100%;overflow:hidden}</style></head>" +
                $"<body><img src='{safeUrl}' style='display:block;width:100%;height:100%;filter: none;' /></body></html>";
          }

          try {
            var initTask = wb.CoreWebView2 == null
                               ? wb.EnsureCoreWebView2Async(null)
                               : Task.CompletedTask;
            initTask.ContinueWith(
                _ => {
                  if (wb.IsDisposed)
                    return;
                  if (wb.CoreWebView2 != null) {
                    try {
                      wb.CoreWebView2.Settings.AreDefaultContextMenusEnabled =
                          false;
                      wb.CoreWebView2.Settings.IsZoomControlEnabled = false;
                      wb.CoreWebView2.Settings.IsStatusBarEnabled = false;
                    } catch {
