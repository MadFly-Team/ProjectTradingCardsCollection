  private async Task DisplayCard(Card card) {
    _currentCard = card;
    lblCardName.Text = card.Name;
    lblCardValue.Text = FormatCardValue(card.Prices);
    lblManaCost.Text = $"Energy types: {(card.Colors is { Count: > 0 } ? string.Join(", ", card.Colors) : "N/A")}";
    lblType.Text = $"Category / Stage: {card.TypeLine}";
    lblOracleText.Text = $"Attacks & Abilities:\n{card.OracleText ?? "N/A"}";

    if (!string.IsNullOrEmpty(card.Power))
      lblPowerToughness.Text = $"HP: {card.Power}";
    else
      lblPowerToughness.Text = "";

    lblSetInfo.Text =
        $"Set: {card.SetName} ({card.Set.ToUpper()}) #{card.CollectorNumber}";
    lblRarity.Text = $"Rarity: {card.Rarity}";
    lblArtist.Text = $"Artist: {card.Artist ?? "Unknown"}";

    // Update set icon next to the title
    try {
      LoadSetIconInto(wbCardSetIcon, card);
      wbCardSetIcon.BringToFront();
    } catch {
    }

    lblPrices.Text = FormatDetailedPrices(card);

    if (card.Legalities != null && card.Legalities.Any()) {
      var legalText = "Format Legalities:\n";
      foreach (var legality in card.Legalities.Where(l => l.Value == "legal")) {
        legalText += $"  {legality.Key}: {legality.Value}\n";
      }
      lblLegalities.Text = legalText;
    } else {
      lblLegalities.Text = "";
    }

    string? imageUrl = card.ImageUris?.Normal ??
                       card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
    if (!string.IsNullOrEmpty(imageUrl)) {
      var image = await _imageCacheService.GetImageAsync(imageUrl);
      if (image != null) {
        picCardImage.Image = image;
        picCardImage.Visible = true;
        picCardImage.Enabled = true;
        picCardImage.Refresh();
        picCardImage.BringToFront();
      } else {
        picCardImage.Image = null;
        picCardImage.Visible = false;
      }
    } else {
      // show placeholder when no image
      picCardImage.Image = _imageCacheService.GetPlaceholderImage();
      picCardImage.Visible = true;
    }

    // Enable Add to Collection and Load Variants buttons
    btnAddToCollection.Enabled = true;
    btnLoadVariants.Enabled = true;
    try {
      btnLoadVariantsImage.Enabled = true;
    } catch {
    }
  }

  private string FormatDetailedPrices(Card card) {
    if (card.Prices == null)
      return "Prices: Not available";
    var text = $"This Version:\nNormal: {_gbpPrices.FormatPrice(card.Prices)}\nHolo: {_gbpPrices.FormatPrice(card.Prices, foil: true)}";
    if (!string.IsNullOrEmpty(card.Prices.Eur))
      text += $"\nEUR (Normal): \u20ac{card.Prices.Eur}";
    if (!string.IsNullOrEmpty(card.Prices.EurFoil))
      text += $"\nEUR (Holo): \u20ac{card.Prices.EurFoil}";
    var variantInfo = GetVariantDescription(card);
    if (variantInfo != "Standard")
      text += $"\nVariant Type: {variantInfo}";
    return text;
  }

  private async Task DisplaySelectedCard(Card card) {
    var request = ++_selectedCardRequest;
    _currentSelectedSetCard = null;
    btnLoadSelectedVariants.Enabled = false;
    btnAddSelectedToCollection.Enabled = false;
    picSelectedCard.Image = null;
    lblSelectedCardName.Text = card.Name;
    lblSelectedCardValue.Text = "Loading full card details...";
    lblSelectedCardType.Text = "";
    lblSelectedCardVariant.Text = "";
    lblSelectedCardText.Text = "";
    lblSelectedCardSet.Text = "";
    ReflowSelectedCardInfo();

    try {
      var detailedCard
      if (IsDisposed || request != _selectedCardRequest)
        return;
      card = detailedCard ?? throw new HttpRequestException($"Card '{card.Id}' was not found on TCGdex.");
      _currentSelectedSetCard = card;
    } catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) {
      if (!IsDisposed && request == _selectedCardRequest) {
        lblSelectedCardValue.Text = "Card details unavailable. Select the card again to retry.";
        MessageBox.Show(this, $"Could not load card '{card.Id}' from TCGdex after retrying temporary failures.\n{ex.Message}",
                        "Card details", MessageBoxButtons.OK, MessageBoxIcon.Warning);
      }
      return;
    }

    btnLoadSelectedVariants.Enabled = true;
    btnAddSelectedToCollection.Enabled = true;
    lblSelectedCardName.Text = card.Name;
    lblSelectedCardValue.Text = FormatCardValue(card.Prices);
    lblSelectedCardType.Text = $"Category / Stage: {card.TypeLine}\nHP: {card.Power ?? "N/A"}";

    var variantInfo = GetVariantDescription(card);
    lblSelectedCardVariant.Text =
        $"Variant: {variantInfo}\nFinishes: {GetFinishesText(card)}";

    lblSelectedCardText.Text = $"Attacks & Abilities:\n{card.OracleText ?? "N/A"}";
    lblSelectedCardSet.Text =
        $"Set: {card.SetName}\nRarity: {card.Rarity}\nCollector #: {card.CollectorNumber}\nArtist: {card.Artist ?? "Unknown"}";
    ReflowSelectedCardInfo();

    // Update selected card set icon
    try {
      LoadSetIconInto(wbSelectedSetIcon, card);
      wbSelectedSetIcon.BringToFront();
    } catch {
    }

    string? imageUrl = card.ImageUris?.Normal ??
                       card.CardFaces?.FirstOrDefault()?.ImageUris?.Normal;
    if (!string.IsNullOrEmpty(imageUrl)) {
      var image = await _imageCacheService.GetImageAsync(imageUrl);
      if (image != null) {
        if (IsDisposed || request != _selectedCardRequest)
          return;
        picSelectedCard.Image = image;
      }
    }

    if (IsDisposed || request != _selectedCardRequest)
      return;

    // Reflow to ensure all text is visible
    ReflowSelectedCardInfo();
  }

  private string GetFinishesText(Card card) {
    if (card.Finishes == null || !card.Finishes.Any())
      return "Unknown";

    return string.Join(", ", card.Finishes.Select(f => f switch {
      "normal" => "Normal", "holo" => "Holo", "reverse holo" => "Reverse Holo",
      "first edition" => "First Edition", _ => f
    }));
  }

