  private void JumpToCardNumber() {
    var number = txtJumpToCard.Text.Trim();
    lblJumpToCardStatus.Text = "";
    if (number.Length == 0)
      return;

    var card = _currentSetCards.FirstOrDefault(c =>
        string.Equals(c.CollectorNumber, number, StringComparison.OrdinalIgnoreCase));
    if (card == null) {
      lblJumpToCardStatus.Text = _currentSetCards.Count == 0
          ? "Load a set first."
          : $"Card #{number} not found in this set.";
      return;
    }

    lblJumpToCardStatus.Text = $"#{card.CollectorNumber} - {card.Name}";
    if (cmbViewMode.SelectedIndex == 1) {
      var item = listViewSetCards.Items.Cast<ListViewItem>()
          .FirstOrDefault(i => ReferenceEquals(i.Tag, card));
      if (item != null) {
        foreach (var selected in listViewSetCards.SelectedItems.Cast<ListViewItem>().ToArray())
          selected.Selected = false;
        item.Selected = true;
        item.Focused = true;
        item.EnsureVisible();
      }
    } else {
      var tile = flowLayoutPanelCards.Controls.Cast<Control>()
          .FirstOrDefault(c => ReferenceEquals(c.Tag, card));
      if (tile != null) {
        flowLayoutPanelCards.ScrollControlIntoView(tile);
        SelectCard(card);
      }
    }
  }

  private async Task LoadSetCards(Set set) {
    txtJumpToCard.Clear();
    lblJumpToCardStatus.Text = "";
    lblCurrentSet.Text = $"Loading cards and prices from {set.Name}...";
    btnViewSetCards.Enabled = false;
    prgLoadingSetCards.Style = ProgressBarStyle.Marquee;
    prgLoadingSetCards.Visible = true;

    try {
      var progress = new Progress<PageProgress>(p => {
        if (p.Total.HasValue && p.Total.Value > 0) {
          prgLoadingSetCards.Style = ProgressBarStyle.Continuous;
          prgLoadingSetCards.Maximum = p.Total.Value;
          prgLoadingSetCards.Value =
              Math.Min(prgLoadingSetCards.Maximum, p.Loaded);
        } else {
          prgLoadingSetCards.Style = ProgressBarStyle.Marquee;
        }

        lblCurrentSet.Text =
            $"{set.Name} ({set.Code.ToUpper()}) - Loading {p.Loaded}{(p.Total.HasValue ? $"/{p.Total.Value}" : string.Empty)} cards (page {p.Page})";
      });

      _currentSetCards =
          await _pokemonCardService.GetCardsBySetAsync(set.Code, progress);
      lblCurrentSet.Text =
          $"{set.Name} ({set.Code.ToUpper()}) - {_currentSetCards.Count} cards";

      _isAscendingSort = true;
      btnToggleSortOrder.Text = "? Ascending";

      // Switch to List view by default for set cards
      cmbViewMode.SelectedIndex = 1; // 0: Thumbnails, 1: List

      await ApplySortAndDisplay();
    } catch (Exception ex) {
      MessageBox.Show($"Error loading cards: {ex.Message}", "Error",
                      MessageBoxButtons.OK, MessageBoxIcon.Error);
      lblCurrentSet.Text = $"Error loading {set.Name}";
    } finally {
      prgLoadingSetCards.Visible = false;
      btnViewSetCards.Enabled = true;
    }
  }

