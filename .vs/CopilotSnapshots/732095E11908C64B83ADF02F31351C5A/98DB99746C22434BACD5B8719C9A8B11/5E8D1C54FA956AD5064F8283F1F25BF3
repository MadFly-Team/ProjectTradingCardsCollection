  private void DisplayVariants(List<Card> variants) {
    listViewVariants.Items.Clear();

    if (variants.Count == 0) {
      lblVariantsHeader.Text = "Variants & Printings: None found";
      return;
    }

    lblVariantsHeader.Text = $"Variants & Printings: {variants.Count} found";

    foreach (var variant in variants) {
      var variantType = GetVariantDescription(variant);

      var item = new ListViewItem(variant.SetName);
      item.SubItems.Add(variantType);
      item.SubItems.Add(variant.CollectorNumber);

      item.SubItems.Add(_gbpPrices.FormatPrice(variant.Prices));
      item.SubItems.Add(_gbpPrices.FormatPrice(variant.Prices, foil: true));

      item.SubItems.Add(variant.ReleasedAt ?? "N/A");
      item.Tag = variant;

      listViewVariants.Items.Add(item);
    }
  }

  private void DisplaySelectedCardVariants(List<Card> variants) {
    listViewSelectedVariants.Items.Clear();

    if (variants.Count == 0) {
      lblSelectedVariantsHeader.Text = "All Variants: None found";
      return;
    }

    lblSelectedVariantsHeader.Text = $"All Variants: {variants.Count} found";

    foreach (var variant in variants) {
      var variantType = GetVariantDescription(variant);

      var item = new ListViewItem(variant.SetName);
      item.SubItems.Add(variantType);
      item.SubItems.Add(variant.CollectorNumber);

      item.SubItems.Add(_gbpPrices.FormatPrice(variant.Prices));
      item.SubItems.Add(_gbpPrices.FormatPrice(variant.Prices, foil: true));

      item.SubItems.Add(variant.ReleasedAt ?? "N/A");
      item.Tag = variant;

      listViewSelectedVariants.Items.Add(item);
    }
  }

  private string GetVariantDescription(Card card) {
    var descriptions = card.Finishes?.Select(f => f switch {
      "normal" => "Normal",
      "holo" => "Holo",
      "reverse holo" => "Reverse Holo",
      "first edition" => "First Edition",
      _ => f
    }).ToList() ?? new List<string>();

    if (card.Promo)
      descriptions.Add("Promo");

    return descriptions.Count > 0 ? string.Join(", ", descriptions) : "Standard";
  }

