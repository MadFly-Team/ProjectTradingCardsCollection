  private string FormatCardValue(Prices? prices) {
    if (prices == null)
      return "Current Value: Not Available";

    var pricesList = new List<string>();

    if (!string.IsNullOrEmpty(prices.Usd))
      pricesList.Add($"${prices.Usd} USD");

    if (!string.IsNullOrEmpty(prices.UsdFoil))
      pricesList.Add($"${prices.UsdFoil} USD Holo");

    if (!string.IsNullOrEmpty(prices.Eur))
      pricesList.Add($"€{prices.Eur} EUR");

    if (!string.IsNullOrEmpty(prices.EurFoil))
      pricesList.Add($"\u20ac{prices.EurFoil} EUR Holo");

    if (pricesList.Count == 0)
      return "Current Value: Not Available";

    var nonfoil = _gbpPrices.FormatPrice(prices);
    var foil = _gbpPrices.FormatPrice(prices, foil: true);
    var estimates = new List<string>();
    if (nonfoil != "N/A")
      estimates.Add($"Normal: {nonfoil}");
    if (foil != "N/A")
      estimates.Add($"Holo: {foil}");
    var date = _gbpPrices.RateDate?.ToString("yyyy-MM-dd") ?? "unavailable";
    return $"Current Value: {string.Join(" | ", pricesList)}\n{string.Join(" | ", estimates)} (FX: {date})";
  }

